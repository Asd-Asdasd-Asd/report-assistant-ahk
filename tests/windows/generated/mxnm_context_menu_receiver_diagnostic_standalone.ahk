            "Ptr", clientRect.Ptr,
            "Int"
        ) {
            continue
        }
        clientOrigin := Buffer(8, 0)
        if !DllCall(
            "User32\ClientToScreen",
            "Ptr", viewerHwnd,
            "Ptr", clientOrigin.Ptr,
            "Int"
        ) {
            continue
        }
        windows.Push({
